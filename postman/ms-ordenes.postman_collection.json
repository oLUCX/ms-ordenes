{
  "info": {
    "_postman_id": "20172b03-e03f-2a81-cd67-2b0f3fc50967",
    "name": "BodegaNube - ms-ordenes",
    "description": "Ciclo de vida del pedido. Ejecutar en orden (Run collection): recibe un aviso de venta, prueba la idempotencia, edita, cambia estados y elimina. El externalOrderId cambia en cada ejecucion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Recibir aviso de venta (201)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"externalOrderId\", \"shopify-\" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"ordenId\", pm.response.json().id);",
              "pm.test(\"pm.response.json().estado === \\\"PENDIENTE_STOCK\\\"\", () => pm.expect(pm.response.json().estado === \"PENDIENTE_STOCK\").to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/ordenes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"externalOrderId\": \"{{externalOrderId}}\",\n  \"comercioId\": \"comercio-123\",\n  \"items\": [\n    {\n      \"productoId\": \"SKU-1\",\n      \"cantidad\": 2\n    },\n    {\n      \"productoId\": \"SKU-2\",\n      \"cantidad\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
