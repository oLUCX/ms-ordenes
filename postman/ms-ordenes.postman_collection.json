            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"pm.response.json().id == pm.collectionVariables.get(\\\"ordenId\\\")\", () => pm.expect(pm.response.json().id == pm.collectionVariables.get(\"ordenId\")).to.be.true);"
            ]
          }
        }
      ],
